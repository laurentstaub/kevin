{
  "name": "dr-kevin",
  "version": "2.0.0",
  "description": "Recherche BDPM — spécialités, principes actifs, groupes génériques et documents officiels",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:setup": "node scripts/db-setup.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "diagnostic": "node scripts/diagnostic.js",
    "db:sections": "node scripts/db-migrer.js sections.sql",
    "db:recherche": "node scripts/db-migrer.js recherche.sql",
    "build-sections": "node scripts/build-sections.js",
    "build-pdf-sections": "node scripts/build-pdf-sections.js",
    "reparer-encodage": "node scripts/reparer-encodage.js",
    "audit-atc": "psql -v ON_ERROR_STOP=1 -d \"${DATABASE_URL:-${PGDATABASE:-incidents_json}}\" -f sql/audit_atc.sql",
    "diag-atc": "node scripts/diag-atc.js",
    "audit-documents": "psql -v ON_ERROR_STOP=1 -d \"${DATABASE_URL:-${PGDATABASE:-incidents_json}}\" -f sql/audit_documents.sql",
    "check-donnees": "node scripts/check-donnees.js",
    "collect-documents": "node scripts/collect-documents.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.14.1",
    "pug": "^3.0.3",
    "sanitize-html": "^2.17.6"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  },
  "license": "ISC"
}
