extends layout.pug
include _recherche.pug
include _resultats-documents.pug
include _dosages.pug

//- Une ligne par produit (racine de marque), pas par code CIS, avec le nombre
//- de présentations et d'importations regroupées.
//- Un produit trouvé : nom et mentions, laboratoire, puis une ligne par forme
//- avec ses dosages en liens. Le nom n'est pas un lien : on choisit le dosage,
//- comme sur la page d'une molécule.
mixin produit(result)
  li
    .resultat.resultat-produit
      .specialite-ligne
        span.specialite-nom
          = specialite(result.libelle)
          if result.princeps
            span.marque Princeps
          if result.importation
            span.marque Importation parallèle
          if result.commercialise === false
            span.marque Non commercialisé
        if result.titulaires
          span.specialite-labo= result.titulaires
      if result.active_ingredients
        span.resultat-dci= dci(result.active_ingredients)
      each groupeForme in result.formes || []
        each groupeNom in groupeForme.noms
          .resultat-forme
            span.resultat-forme-nom= groupeForme.forme
            +dosages(groupeNom)

block content
  //- Bandeau en deux temps : le titre défile, le champ reste collé en haut
  //- comme la barre des autres pages. Deux blocs frères : collé, le second
  //- ne serait pas retenu par un parent qui défile.
  header.accueil
    .accueil-inner
      +apparence
      //- Le titre sert de retour à l'accueil (pas de barre de situation ici),
      //- sauf sur la page nue, où il reste du texte.
      h1.titre-site
        if results
          a.titre-lien(href="/") Médipile
        else
          | Médipile
      p.accueil-champ Base de données publique des médicaments
  .accueil-colle
    .accueil-inner
      +champRecherche(query, false)

      //- Notice du site, repliée : sa ligne de résumé nomme ce que le champ sait
      //- faire et que son libellé ne dit pas ; dépliée, un exemple cliquable et
      //- une phrase par fonction. La question n'est proposée qu'avec l'IA, sans
      //- qui elle reste sans réponse.
      if !results
        - const genres = ['un passage des RCP', 'une interaction', 'une alternative', 'une boîte']
        - if (ia) genres.push('une question à Kevin')
        details.notice-site
          summary
            | Notice
            span.notice-genres= ` · chercher ${genres.join(' · ')}`
          dl.notice-liste
            dt Un passage des RCP
            dd
              a(href=lien({ mode: 'documents', requete: 'allongement QT' })) allongement QT
              span.notice-explication l'expression dans le texte des RCP et notices, rubrique par rubrique
            dt Une interaction
            dd
              a(href="/interactions?m=kardegic&m=previscan") Kardégic + Previscan
              span.notice-explication deux noms ou plus : ce que la rubrique 4.5 de chaque RCP dit de l'autre
            dt Une alternative
            dd
              //- Doliprane 1000 mg, comprimé : CIS stable de la BDPM.
              a(href="/product/60234100?sans=lactose#alternatives") Doliprane sans lactose
              span.notice-explication génériques et équivalents, sans un excipient à effet notoire
            dt Une boîte
            dd
              //- CIP 13 d'une plaquette de Doliprane 1000 mg : la fiche s'ouvre directement.
              a(href="/search?q=3400935955838") 3400935955838
              span.notice-explication code CIP ou Datamatrix lu à la douchette : la fiche directement
            if ia
              dt Une question à Kevin
              dd
                a(href=lien({ mode: 'nom', requete: 'couper le Lévothyrox ?' })) couper le Lévothyrox ?
                span.notice-explication en langage courant : Kevin, l'IA, la traduit en recherche ; la réponse est citée des RCP

  .recherche
    if notice
      p.notice= notice

    //- Entrée par classe ATC, pour qui ne cherche pas un nom.
    if !results && classes && classes.length > 0
      nav.classes(aria-label="Parcourir par classe thérapeutique")
        h2.classes-titre
          | Parcourir par classe thérapeutique
          span.classes-unite Spécialités commercialisées
        ul.classes-liste
          each classe in classes
            li
              a.classe-lien(href=`/classe/${classe.code}`)
                span.classe-code= classe.code
                span.classe-label= phrase(classe.label)
                span.classe-compte= classe.specialites.toLocaleString('fr-FR')

    //- Les vingt molécules les plus fournies, toutes classes confondues ; les
    //- autres se trouvent par les classes.
    if !results && molecules && molecules.length > 0
      nav.classes.classes-molecules(aria-label="Top 20 des molécules avec le plus de spécialités")
        h2.classes-titre
          | Top 20 des molécules avec le plus de spécialités
          span.classes-unite Spécialités commercialisées
        ul.classes-liste
          each molecule in molecules
            li
              a.classe-lien(href=`/classe/${molecule.code}`)
                span.classe-code= molecule.code
                span.classe-label= dci(molecule.label)
                span.classe-compte= molecule.specialites.toLocaleString('fr-FR')

    #results
      if results
        //- Filtres au-dessus de la liste qu'ils pilotent.
        nav.filtres(aria-label="Filtrer les résultats")
          a.filtre(class=(filter === 'all' ? 'actif' : ''), href=lien(etat, { filtre: 'all' })) Tous
          a.filtre(class=(filter === 'specialty' ? 'actif' : ''), href=lien(etat, { filtre: 'specialty' })) Dénomination
          a.filtre(class=(filter === 'active' ? 'actif' : ''), href=lien(etat, { filtre: 'active' })) Principe actif
          //- Recherche plein texte : autre page (ses propres filtres), mais annoncée ici.
          a.filtre.filtre-ailleurs(href=lien(etat, { mode: 'documents' }))
            | Dans les documents
            if documents && documents.total > 0
              span.filtre-compte #{documents.total.toLocaleString('fr-FR')}

        if results.total > 0
          //- Terme = molécule : une seule liste, sinon le princeps (SERESTA) passerait
          //- sous les génériques qui portent le nom (OXAZEPAM <labo>).
          if results.dci
            section.groupe
              h2.groupe-titre
                | Médicaments contenant #{results.substance || query}
                span.compte #{results.produits.length}
              ul.liste
                each result in results.produits
                  +produit(result)
          else
            if results.brandMatches.length > 0
              section.groupe
                h2.groupe-titre
                  | Trouvés par dénomination
                  span.compte #{results.brandMatches.length}
                ul.liste
                  each result in results.brandMatches
                    +produit(result)

            if results.activeIngredientMatches.length > 0
              section.groupe
                h2.groupe-titre
                  | Trouvés par principe actif
                  span.compte #{results.activeIngredientMatches.length}
                ul.liste
                  each result in results.activeIngredientMatches
                    +produit(result)
        else if !documents || documents.resultats.length === 0
          p.vide Aucun résultat pour « #{query} ».

        //- Documents sous les spécialités ; seuls s'il n'y a aucune spécialité.
        if panne
          p.section-meta= panne
        if documents && documents.resultats.length > 0
          section.groupe
            h2.groupe-titre
              | Dans les documents
              span.compte #{documents.total.toLocaleString('fr-FR')}
            +resultatsDocuments(documents, query, true, colonnes, null, etat, lien)

block scripts
  script(src=`/js/search.js?v=${v}` defer)
  script(src=`/js/extraits.js?v=${v}` defer)
