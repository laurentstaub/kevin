extends layout.pug

//- Une ligne = un produit, pas un code CIS.
//-
//- DOLIPRANE compte dix-sept CIS : les lister, c'est remplir l'écran d'un seul
//- médicament. La ligne porte donc la racine de marque, et dit ce que le
//- regroupement recouvre — combien de présentations, combien d'importations —
//- pour que le lecteur sache qu'il n'a rien perdu en chemin.
mixin produit(result)
  li
    a.resultat(href=`/product/${result.id}`)
      span.resultat-nom
        = result.libelle
        //- Dire pourquoi la ligne est là où elle est : sur une recherche de
        //- molécule, le princeps passe devant ses génériques, et le lecteur
        //- doit pouvoir le constater plutôt que le deviner.
        if result.princeps
          span.marque Princeps
        if result.importation
          span.marque Importation parallèle
        if result.commercialise === false
          span.marque Non commercialisé
      span.resultat-dci
        if result.active_ingredients
          = result.active_ingredients
        if result.active_ingredients && result.forme_pharmaceutique
          span.sep
        if result.forme_pharmaceutique
          = result.forme_pharmaceutique
      if result.presentations > 1 || result.importations > 0
        span.resultat-etendue
          //- « dosages et formes » et non « présentations » : la fiche produit
          //- réserve ce mot aux conditionnements CIP, qui sont autre chose.
          if result.presentations > 1
            = `${result.presentations} dosages et formes`
          if result.presentations > 1 && result.importations > 0
            span.sep
          if result.importations > 0
            = `${result.importations} importation${result.importations > 1 ? 's' : ''} parallèle${result.importations > 1 ? 's' : ''}`

block content
  .recherche
    header.recherche-tete
      h1.titre-site Demander à Kevin
      p.page-meta Base de données publique des médicaments · spécialités, principes actifs, groupes génériques

    .search-wrapper
      form.search-form(method="GET" action="/search" role="search")
        .input-wrapper
          input.search-input(
            type="search"
            name="q"
            placeholder="Dénomination ou principe actif"
            value=query
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            aria-label="Rechercher un médicament"
            aria-autocomplete="list"
            aria-controls="suggestions"
          )
          button.search-button(type="submit") Chercher

      #suggestions.suggestions(role="listbox" hidden)
        .suggestions-list

    #loading.loading(role="status" aria-live="polite") Recherche…

    if notice
      p.notice= notice

    #results
      if results
        //- Les filtres pilotent la liste : ils sont au-dessus d'elle.
        nav.filtres(aria-label="Filtrer les résultats")
          a.filtre(class=(filter === 'all' ? 'actif' : ''), href=`/search?q=${encodeURIComponent(query)}`) Tous
          a.filtre(class=(filter === 'specialty' ? 'actif' : ''), href=`/search?q=${encodeURIComponent(query)}&filter=specialty`) Dénomination
          a.filtre(class=(filter === 'active' ? 'actif' : ''), href=`/search?q=${encodeURIComponent(query)}&filter=active`) Principe actif

        if results.total > 0
          //- Le terme désigne une molécule : une seule liste.
          //-
          //- Séparer selon que le mot figure ou non dans la dénomination n'a de
          //- sens que pour une marque. Sur « oxazépam », cela mettait les trois
          //- OXAZEPAM <labo> au-dessus, et SERESTA — le princeps, celui qu'on
          //- cherche — dans une seconde section, sous eux.
          if results.dci
            section.groupe
              h2.groupe-titre
                | Médicaments contenant #{results.substance || query}
                span.compte #{results.produits.length}
              ul.liste
                each result in results.produits
                  +produit(result)
          else
            if results.brandMatches.length > 0
              section.groupe
                h2.groupe-titre
                  | Trouvés par dénomination
                  span.compte #{results.brandMatches.length}
                ul.liste
                  each result in results.brandMatches
                    +produit(result)

            if results.activeIngredientMatches.length > 0
              section.groupe
                h2.groupe-titre
                  | Trouvés par principe actif
                  span.compte #{results.activeIngredientMatches.length}
                ul.liste
                  each result in results.activeIngredientMatches
                    +produit(result)
        else
          p.vide Aucun résultat pour « #{query} ».

block scripts
  script(src=`/js/search.js?v=${v}` defer)
