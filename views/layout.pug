include _rail.pug
include _theme.pug
doctype html
html(lang="fr")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title || 'Demander à Kevin'
    //- Apparence choisie, posée avant les styles : pas de page qui change de
    //- couleur au chargement. Fichier externe : la politique de sécurité
    //- (script-src 'self') refusait le script en ligne, et le choix mémorisé
    //- ne s'appliquait qu'après l'affichage, par theme.js.
    script(src=`/js/apparence.js?v=${v}`)
    link(rel="stylesheet", href=`/css/tokens.css?v=${v}`)
    link(rel="stylesheet", href=`/css/app.css?v=${v}`)
    block styles
  body
    //- Pas de rail sur l'accueil (il liste déjà les classes) ni sur les résultats :
    //- la recherche prend toute la largeur.
    if !sansRail
      +rail(rail, railActif, sections, documents)
    block content
    script(src=`/js/theme.js?v=${v}` defer)
    block scripts
