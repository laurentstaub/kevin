include _rail.pug
include _theme.pug
doctype html
html(lang="fr")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title || 'Médipile'
    //- Référencement : description, adresse canonique, ou hors index (résultats).
    if description
      meta(name="description" content=description)
    if noindex
      meta(name="robots" content="noindex")
    else if canonique
      link(rel="canonical" href=canonique)
    //- Icône : SVG pour les navigateurs récents, .ico pour les autres, PNG pour l'écran d'accueil iOS.
    link(rel="icon" href="/favicon.ico" sizes="32x32")
    link(rel="icon" href="/favicon.svg" type="image/svg+xml")
    link(rel="apple-touch-icon" href="/apple-touch-icon.png")
    //- Recherche depuis la barre d'adresse du navigateur.
    link(rel="search" type="application/opensearchdescription+xml" title="Médipile" href="/opensearch.xml")
    //- Apparence choisie, posée avant les styles : pas de page qui change de
    //- couleur au chargement. Fichier externe : la politique de sécurité
    //- (script-src 'self') refusait le script en ligne, et le choix mémorisé
    //- ne s'appliquait qu'après l'affichage, par theme.js.
    script(src=`/js/apparence.js?v=${v}`)
    link(rel="stylesheet", href=`/css/tokens.css?v=${v}`)
    link(rel="stylesheet", href=`/css/app.css?v=${v}`)
    block styles
  body
    //- Pas de rail sur l'accueil (il liste déjà les classes) ni sur les résultats :
    //- la recherche prend toute la largeur.
    if !sansRail
      +rail(rail, railActif, sections, documents)
    block content
    //- Qui est derrière le site, et où écrire : une ligne, sur toutes les pages.
    if pied
      footer.pied
        span Médipile
        each lien in pied.pages
          span.sep
          a(href=lien.adresse)= lien.titre
        span.sep
        a(href=`mailto:${pied.contact}`)= pied.contact
    script(src=`/js/theme.js?v=${v}` defer)
    block scripts
