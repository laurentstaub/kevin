//- Champ de recherche partagé : un seul balisage, car `public/js/search.js`
//- s'accroche à ces classes et identifiants.
//- Le libellé compact dit « un médicament » pour ne pas évoquer une recherche dans la page.
//-
//- @param {string} valeur   ce que porte le champ au chargement
//- @param {boolean} compact version d'en-tête, posée sur une ligne de navigation
//- @param {string} action  où resoumettre : la page courante, pour ne pas changer de mode
mixin champRecherche(valeur, compact, action)
  .search-wrapper(class=compact ? 'search-compacte' : null)
    form.search-form(method="GET" action=action || "/search" role="search")
      .input-wrapper
        input.search-input(
          type="search"
          name="q"
          placeholder=compact ? 'Chercher un médicament…' : 'Dénomination, principe actif ou expression'
          value=valeur
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          aria-label="Rechercher un médicament"
          aria-autocomplete="list"
          aria-controls="suggestions"
        )
        button.search-button(type="submit")= compact ? '→' : 'Chercher'

    #suggestions.suggestions(role="listbox" hidden)
      .suggestions-list

    #loading.loading(role="status" aria-live="polite") Recherche…
