//- Champ de recherche, partagé par l'accueil, la fiche produit et les classes.
//-
//- La fiche n'offrait qu'un lien vers l'accueil : chercher un autre médicament
//- imposait un aller-retour, alors qu'au comptoir on enchaîne les recherches.
//-
//- Un seul balisage pour les trois pages, parce que `public/js/search.js`
//- s'accroche à ces classes et à ces identifiants — deux copies divergeraient,
//- et l'autocomplétion cesserait de fonctionner d'un côté sans qu'on le voie.
//-
//- @param {string} valeur   ce que porte le champ au chargement
//- @param {boolean} compact version d'en-tête, posée sur une ligne de navigation
//- @param {string} action  où resoumettre — la page courante, et non toujours
//-                         la recherche par nom : depuis les documents, taper
//-                         un mot renvoyait à l'autre mode sans prévenir, et
//-                         un champ prérempli aurait rendu le piège pire,
//-                         puisqu'on croit affiner quand on change de question
//-
//- « Rechercher… », dans une barre collante, se lisait comme une recherche dans
//- la page — le réflexe ⌘F. Ce champ cherche un autre médicament : il doit le
//- dire, sinon il promet le contraire de ce qu'il fait.
//-
//- Et sur l'accueil il énumérait « Dénomination ou principe actif », ce qui ne
//- laissait pas ignorer la recherche plein texte : ça la niait. Le troisième
//- terme manquait.
mixin champRecherche(valeur, compact, action)
  .search-wrapper(class=compact ? 'search-compacte' : null)
    form.search-form(method="GET" action=action || "/search" role="search")
      .input-wrapper
        input.search-input(
          type="search"
          name="q"
          placeholder=compact ? 'Chercher un médicament…' : 'Dénomination, principe actif ou expression'
          value=valeur
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          aria-label="Rechercher un médicament"
          aria-autocomplete="list"
          aria-controls="suggestions"
        )
        button.search-button(type="submit")= compact ? '→' : 'Chercher'

    #suggestions.suggestions(role="listbox" hidden)
      .suggestions-list

    #loading.loading(role="status" aria-live="polite") Recherche…
