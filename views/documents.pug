extends layout.pug
include _barre.pug
include _recherche.pug
include _resultats-documents.pug

//- Recherche plein texte, vue complète.
//-
//- Une page, une question : où cette expression figure-t-elle dans les
//- documents. Le filtre par rubrique vit ici et nulle part ailleurs — le mêler
//- à ceux de la recherche par nom ferait une page qui en pose deux.

block content
  //- La barre porte la requête dans son champ : le titre n'a plus à la
  //- répéter, il dit où l'on est.
  +barreSituation('Dans les documents', query, '/documents')

  main.corps
    header.doc-entete
      h1.section-titre Dans les documents
      p.page-meta
        | Recherche du texte des résumés des caractéristiques et des notices,
        |  rubrique par rubrique.

      //- L'état de la recherche, en un seul endroit.
      //-
      //- Il vivait en trois morceaux qui ne se touchaient pas : la barre
      //- disait la requête, l'en-tête du tableau la rubrique, et le décompte
      //- ne paraissait que si la recherche avait été plafonnée — c'est-à-dire
      //- jamais quand on filtre, puisque filtrer fait passer sous le plafond.
      //- Ici : ce qu'on a cherché, ce qu'on a restreint, ce que ça donne.
      if !panne && !notice
        p.etat
          span.etat-requete= `« ${query} »`
          if rubrique
            //- Le jeton se défait d'un clic : un filtre qu'on ne sait pas
            //- retirer se retire en refaisant la recherche.
            a.jeton(href=`/documents?q=${encodeURIComponent(query)}`
              title="Rechercher dans tout le document")
              | rubrique #{rubrique}
              span.jeton-croix ×
          span.etat-compte
            if documents.borne
              | plus de #{documents.total.toLocaleString('fr-FR')} rubriques
            else
              | #{documents.total.toLocaleString('fr-FR')} rubrique#{documents.total > 1 ? 's' : ''}

    //- La rangée d'onglets qui vivait ici a disparu.
    //-
    //- Elle listait les huit mêmes rubriques que l'en-tête du tableau, deux
    //- lignes au-dessus de lui : la même liste écrite deux fois sur le même
    //- écran, dont l'une ne portait aucune donnée. Le filtre n'est pas perdu
    //- pour autant — il est passé dans l'en-tête, qui est sa place : on
    //- restreint une colonne en cliquant sur la colonne.
    if panne
      p.vide= panne
    else if notice
      p.vide= notice
    else if documents.resultats.length === 0
      p.vide Aucune rubrique ne contient « #{query} »#{rubrique ? ` dans la rubrique ${rubrique}` : ''}.
    else
      +resultatsDocuments(documents, query, false, colonnes, rubrique)

      //- Où l'on en est, et comment aller plus loin.
      //-
      //- Sans ces deux liens la page annonçait des milliers de rubriques et
      //- n'en montrait que vingt : le lecteur en concluait, à raison, qu'il
      //- manquait quelque chose. On ne numérote pas les pages — cent cinquante
      //- numéros ne se choisissent pas — on avance et on recule.
      - var base = `/documents?q=${encodeURIComponent(query)}${rubrique ? `&rubrique=${rubrique}` : ''}`
      - var premier = documents.decalage + 1
      - var dernier = documents.decalage + documents.resultats.length
      nav.pages(aria-label="Pagination des résultats")
        if page > 1
          a.page-prec(href=`${base}${page > 2 ? `&page=${page - 1}` : ''}`) ← Précédents
        span.page-rang Résultats #{premier.toLocaleString('fr-FR')} à #{dernier.toLocaleString('fr-FR')}
        if documents.suite
          a.page-suiv(href=`${base}&page=${page + 1}`) Suivants →

block scripts
  script(src=`/js/search.js?v=${v}` defer)
  script(src=`/js/extraits.js?v=${v}` defer)
