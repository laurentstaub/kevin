extends layout.pug
include _barre.pug
include _recherche.pug
include _resultats-documents.pug

//- Recherche plein texte, vue complète.
//-
//- Une page, une question : où cette expression figure-t-elle dans les
//- documents. Les filtres par rubrique vivent ici et nulle part ailleurs —
//- les mêler à ceux de la recherche par nom ferait une page qui en pose deux.

block content
  +barreSituation(`« ${query} » dans les documents`)

  main.corps
    header.doc-entete
      h1.section-titre Dans les documents
      p.page-meta
        | Recherche du texte des résumés des caractéristiques et des notices,
        |  rubrique par rubrique.

    //- Les filtres pilotent la liste : ils sont au-dessus d'elle.
    nav.filtres(aria-label="Filtrer par rubrique")
      a.filtre(class=(rubrique ? '' : 'actif')
        href=`/documents?q=${encodeURIComponent(query)}`) Tout le document
      each r in colonnes
        a.filtre(class=(rubrique === r[0] ? 'actif' : '')
          href=`/documents?q=${encodeURIComponent(query)}&rubrique=${r[0]}`)
          span.filtre-num= r[0]
          = r[1]

    if panne
      p.vide= panne
    else if notice
      p.vide= notice
    else if documents.resultats.length === 0
      p.vide Aucune rubrique ne contient « #{query} »#{rubrique ? ` dans la rubrique ${rubrique}` : ''}.
    else
      +resultatsDocuments(documents, query, false, colonnes)

      //- Où l'on en est, et comment aller plus loin.
      //-
      //- Sans ces deux liens la page annonçait des milliers de rubriques et
      //- n'en montrait que vingt : le lecteur en concluait, à raison, qu'il
      //- manquait quelque chose. On ne numérote pas les pages — cent cinquante
      //- numéros ne se choisissent pas — on avance et on recule.
      - var base = `/documents?q=${encodeURIComponent(query)}${rubrique ? `&rubrique=${rubrique}` : ''}`
      - var premier = documents.decalage + 1
      - var dernier = documents.decalage + documents.resultats.length
      nav.pages(aria-label="Pagination des résultats")
        if page > 1
          a.page-prec(href=`${base}${page > 2 ? `&page=${page - 1}` : ''}`) ← Précédents
        span.page-rang Résultats #{premier.toLocaleString('fr-FR')} à #{dernier.toLocaleString('fr-FR')}
        if documents.suite
          a.page-suiv(href=`${base}&page=${page + 1}`) Suivants →

block scripts
  script(src=`/js/search.js?v=${v}` defer)
