extends layout.pug
include _barre.pug
include _recherche.pug
include _resultats-documents.pug
include _dosages.pug

//- Recherche plein texte, vue complète. Seule page à porter le filtre par rubrique.

block content
  //- La requête est dans le champ de la barre ; le titre de la page dit où l'on
  //- est. Pas de libellé à côté du champ : lu comme le mode de la saisie, il
  //- promettait de rester dans les documents, alors qu'une nouvelle saisie
  //- repart de la recherche par nom, comme partout.
  //- Question interprétée : le champ garde la question telle que tapée.
  +barreSituation(null, etat.question || query)

  main.corps
    header.doc-entete
      h1.section-titre Dans les documents
      p.page-meta
        | Recherche du texte des résumés des caractéristiques et des notices,
        |  rubrique par rubrique.

      //- Saisie réorientée : par l'IA (annoncée, AI Act art. 50) ou par la base ; refusable.
      if etat.question
        p.ia-interpretation
          if etat.ia
            | Question « #{etat.question} » interprétée par Kevin, l'IA de Médipile. Résultats : texte officiel des RCP.
          else
            | « #{etat.molecule} » reconnu comme médicament : résultats limités à ses spécialités.
          |
          a(href=lien({ mode: 'documents', requete: etat.question, brut: '1' })) Chercher tel quel

      //- État de la recherche en un seul endroit : requête, molécule, rubrique, décompte.
      if !panne && !notice
        p.etat
          span.etat-requete= `« ${query} »`
          if etat.molecule
            //- Deux gestes distincts : le nom mène aux spécialités de la molécule ;
            //- la croix retire le filtre et cherche dans toutes les molécules.
            span.jeton.jeton-double
              a.jeton-nom(href=lien({ mode: 'nom', requete: etat.molecule })
                title=`Spécialités : ${dci(etat.molecule)}`)= dci(etat.molecule)
              a.jeton-croix(href=lien(etat, { molecule: null })
                title="Retirer ce filtre : chercher dans toutes les molécules"
                aria-label=`Retirer le filtre ${dci(etat.molecule)}`) ×
          if rubrique
            //- Le jeton retire le filtre d'un clic.
            a.jeton(href=lien(etat, { rubrique: null })
              title="Rechercher dans tout le document")
              | rubrique #{rubrique}
              span.jeton-croix ×
          span.etat-compte
            | #{documents.total.toLocaleString('fr-FR')} rubrique#{documents.total > 1 ? 's' : ''}
            //- Toutes classées, seules les premières détaillées : le dire.
            if documents.borne
              |  · #{documents.molecules.toLocaleString('fr-FR')} molécules, les #{documents.moleculesMax} premières détaillées

        //- Élargissements du thésaurus, annoncés et refusables (« mot pour mot » :
        //- une requête entre guillemets n'est jamais élargie).
        if documents.elargissements && documents.elargissements.length > 0
          p.elargi
            each elargissement, i in documents.elargissements
              if i > 0
                |  ·
              | « #{elargissement.terme} » cherché aussi comme
              |
              span.elargi-vers= elargissement.vers.map((v) => `« ${v} »`).join(', ')
            | .
            |  Recherche de l’expression exacte
            |
            a.elargi-exact(href=lien(etat, { requete: `"${query.replace(/"/g, '')}"` })
              title="Chercher les mots tapés, et rien d'autre") « #{query.replace(/"/g, '')} »
            | .

    //- Le filtre par rubrique est dans l'en-tête du tableau.
    if panne
      p.vide= panne
    else if notice
      p.vide= notice
    else if lecture
      //- Une rubrique lue pour le médicament, rédaction par rédaction, citée
      //- telle quelle. Le silence se dit : « ne mentionne pas », vide, absente.
      - const fiche = (ligne) => `/product/${ligne.cis}?q=${encodeURIComponent(query)}${ligne.ancre ? `#${ligne.ancre}` : ''}`
      if lecture.redactions > lecture.lignes.length
        p.lecture-compte #{lecture.specialites} spécialités, #{lecture.redactions} rédactions de la rubrique #{rubrique} : les #{lecture.lignes.length} plus répandues.
      ul.lecture
        each ligne in lecture.lignes
          li.lecture-forme(class=`lecture-${ligne.statut}`)
            span.lecture-tete
              a.lecture-nom(href=fiche(ligne) title=ligne.ancre ? 'Ouvrir la rubrique dans la fiche' : 'Ouvrir la fiche')= specialite(ligne.denomination)
              if ligne.autres.length
                span.lecture-autres(title=ligne.autres.map(specialite).join(' · ') + (ligne.nombre > ligne.autres.length + 1 ? ' …' : ''))
                  |  et #{ligne.nombre - 1} autre#{ligne.nombre > 2 ? 's' : ''}
            case ligne.statut
              when 'trouve'
                span.lecture-texte!= ligne.html
              when 'entiere'
                span.lecture-texte!= ligne.html
                span.lecture-etat  · ne mentionne pas « #{query} »
              when 'muette'
                span.lecture-etat Rubrique #{rubrique} : ne mentionne pas « #{query} »
              when 'vide'
                span.lecture-etat Rubrique vide
              when 'absente'
                span.lecture-etat Rubrique absente
              default
                span.lecture-etat RCP absent
            //- Texte long : la réponse n'est pas toujours la phrase qui porte le mot
            //- (« 3000 mg par jour » est dans un tableau) ; la rubrique entière, à déplier.
            if ligne.complet
              details.lecture-complet
                summary Toute la rubrique #{rubrique}
                .lecture-html!= ligne.complet
    else if documents.resultats.length === 0
      p.vide
        | Aucune rubrique ne contient « #{query} »#{rubrique ? ` dans la rubrique ${rubrique}` : ''}#{etat.molecule ? ` pour « ${etat.molecule} »` : ''}.
        if rubrique
          |  
          a(href=lien(etat, { rubrique: null })) Chercher dans toutes les rubriques
        //- Médicament filtré et rien : ses fiches (la bande y lit sécabilité,
        //- administration, grossesse…), ou la même recherche sans le filtre.
        else if etat.molecule
          |  
          a(href=lien({ mode: 'nom', requete: etat.molecule })) Voir ses spécialités
          |  · 
          a(href=lien(etat, { molecule: null })) Chercher dans tous les médicaments
    else
      +resultatsDocuments(documents, query, false, colonnes, rubrique, etat, lien, ciblee)

      //- Pagination précédent/suivant, sans numéros (trop de pages pour en choisir une).
      - const premier = documents.decalage + 1
      - const dernier = documents.decalage + documents.resultats.length
      nav.pages(aria-label="Pagination des résultats")
        if page > 1
          a.page-prec(href=lien(etat, { page: page - 1 })) ← Précédents
        span.page-rang Résultats #{premier.toLocaleString('fr-FR')} à #{dernier.toLocaleString('fr-FR')}
        if documents.suite
          a.page-suiv(href=lien(etat, { page: page + 1 })) Suivants →

block scripts
  script(src=`/js/search.js?v=${v}` defer)
  script(src=`/js/extraits.js?v=${v}` defer)
