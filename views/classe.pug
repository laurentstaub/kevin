extends layout.pug
include _barre.pug
include _recherche.pug

//- Une classe thérapeutique : son fil, et ce qu'elle contient.
//-
//- Une classe montre ses enfants directs ; seule la feuille — la molécule, ou
//- l'association — montre ses spécialités. Plus haut, la liste des spécialités
//- doublait les sous-classes et devait être tronquée : sur six cents produits
//- on n'en voyait que le début de l'alphabet, ce qui n'apprend rien et laisse
//- croire que la classe s'arrête à B. Et douze ABACAVIR d'affilée ne disent
//- qu'une chose, que l'abacavir existe chez douze laboratoires — un
//- renseignement qui appartient à la page de l'abacavir, pas à celle de la
//- classe.

block content
  +barreSituation(classe.label)

  .recherche
    header.recherche-tete
      p.page-meta
        each niveau, i in classe.chaine
          if i > 0
            span.atc-sep ›
          if niveau.code === classe.code
            span= niveau.code
          else
            a(href=`/classe/${niveau.code}`)= niveau.code
      h1.titre-site= classe.label
      //- Un seul chiffre, et le code une seule fois. La page en portait deux —
      //- le total de la classe et le nombre de lignes affichées — dont le
      //- second n'était pas un décompte mais une troncature déguisée en
      //- information. Et le code figurait ici en plus du fil, qui se termine
      //- déjà par lui : sur « J », la page affichait « J » deux fois de suite.
      if classe.produits
        p.page-meta #{classe.produits.toLocaleString('fr-FR')} produit#{classe.produits > 1 ? 's' : ''}

    if classe.enfants.length > 0
      nav.classes(aria-label="Sous-classes")
        h2.classes-titre Sous-classes
        ul.classes-liste
          each enfant in classe.enfants
            li
              a.classe-lien(href=`/classe/${enfant.code}`)
                span.classe-code= enfant.code
                span.classe-label= enfant.label
                span.classe-compte #{enfant.produits.toLocaleString('fr-FR')} produits

    //- Ce que la classe contient, et non comment elle se découpe.
    //-
    //- Les sous-classes disent le second ; « Antiviraux à action directe »
    //- n'apprend rien à qui cherche quels antiviraux existent. Cette liste
    //- aplatit l'arbre — toutes les feuilles de la classe, la plus répandue
    //- d'abord. Vingt suffisent à donner la physionomie d'une classe ; le reste
    //- est là, replié, parce qu'une liste écourtée en silence se lit comme une
    //- liste complète.
    if molecules && molecules.length > 0
      - var TETE = 20
      - var principales = molecules.slice(0, TETE)
      - var reste = molecules.slice(TETE)
      nav.classes.classes-molecules(aria-label="Molécules de la classe")
        h2.classes-titre
          | Molécules
          span.compte= molecules.length.toLocaleString('fr-FR')
        ul.classes-liste
          each molecule in principales
            li
              a.classe-lien(href=`/classe/${molecule.code}`)
                span.classe-code= molecule.code
                span.classe-label= molecule.label
                span.classe-compte #{molecule.produits.toLocaleString('fr-FR')} produit#{molecule.produits > 1 ? 's' : ''}
        if reste.length > 0
          details.molecules-reste
            summary.molecules-plus #{reste.length.toLocaleString('fr-FR')} autre#{reste.length > 1 ? 's' : ''} molécule#{reste.length > 1 ? 's' : ''}
            ul.classes-liste
              each molecule in reste
                li
                  a.classe-lien(href=`/classe/${molecule.code}`)
                    span.classe-code= molecule.code
                    span.classe-label= molecule.label
                    span.classe-compte #{molecule.produits.toLocaleString('fr-FR')} produit#{molecule.produits > 1 ? 's' : ''}

    if feuille
      section.groupe
        h2.groupe-titre
          | Produits
          span.compte #{produits.length.toLocaleString('fr-FR')}
        ul.liste
          each produit in produits
            li
              a.resultat(href=`/product/${produit.id}`)
                span.resultat-nom
                  = produit.racine
                  if produit.importation
                    span.marque Importation parallèle
                  if produit.commercialise === false
                    span.marque Non commercialisé
                span.resultat-dci
                  if produit.active_ingredients
                    = produit.active_ingredients
                  if produit.active_ingredients && produit.forme_pharmaceutique
                    span.sep
                  if produit.forme_pharmaceutique
                    = produit.forme_pharmaceutique
                if produit.presentations > 1
                  span.resultat-etendue= `${produit.presentations} dosages et formes`

block scripts
  script(src=`/js/search.js?v=${v}` defer)
