extends layout.pug
include _barre.pug
include _recherche.pug

//- Une classe thérapeutique : son fil, et ce qu'elle contient.
//-
//- Une classe montre ses enfants directs ; seule la feuille — la molécule, ou
//- l'association — montre ses spécialités. Plus haut, la liste des spécialités
//- doublait les sous-classes et devait être tronquée : sur mille spécialités
//- on n'en voyait que le début de l'alphabet, ce qui n'apprend rien et laisse
//- croire que la classe s'arrête à B. Et douze ABACAVIR d'affilée ne disent
//- qu'une chose, que l'abacavir existe chez douze laboratoires — un
//- renseignement qui appartient à la page de l'abacavir, pas à celle de la
//- classe.

mixin specialites(n)
  if n > 0
    | #{n.toLocaleString('fr-FR')} spécialité#{n > 1 ? 's' : ''} commercialisée#{n > 1 ? 's' : ''}
  else
    | Aucune spécialité commercialisée

//- Les spécialités d'une forme : une ligne par nom, les dosages à la suite,
//- chacun lien vers sa spécialité. « ABSTRAL 100 · 200 · 300 microgrammes »
//- au lieu de trois lignes qui ne diffèrent que d'un chiffre.
mixin formes(groupes)
  each f in groupes
    //- Une seule forme : pas de sous-titre, il ne distinguerait rien.
    if groupes.length > 1
      h3.forme-titre
        | #{f.forme.charAt(0).toUpperCase() + f.forme.slice(1)}
        span.compte= f.total.toLocaleString('fr-FR')
    ul.liste.specialites-liste
      each n in f.noms
        li
          .specialite-ligne
            span.specialite-nom
              if n.dosages.length === 1
                - var seul = n.dosages[0]
                a.specialite-lien(href=`/product/${seul.id}`)
                  = n.nom
                  if seul.libelle.indexOf(n.nom) !== 0
                    |  #{seul.libelle}#{n.unite ? ' ' + n.unite : ''}
              else
                = n.nom
              //- La mention suit le nom, avant les dosages : elle qualifie
              //- le nom, et se retrouve à la même place d'une ligne à l'autre.
              if n.princeps
                span.marque Princeps
              else if n.biologique === 'reference'
                span.marque(title="Médicament biologique de référence de son groupe biosimilaire (ANSM)") Référence
              if n.biologique === 'biosimilaire'
                span.marque(title="Inscrit sur la liste de référence des groupes biologiques similaires (ANSM)") Biosimilaire
              if n.importation
                span.marque Importation parallèle
              if n.dosages.length > 1
                span.specialite-dosages
                  each d, i in n.dosages
                    if i > 0
                      span.sep-point  · 
                    a.specialite-dosage(href=`/product/${d.id}` title=d.detail)= d.libelle
                  if n.unite
                    |  #{n.unite}
            if n.titulaires
              span.specialite-labo= n.titulaires

block content
  +barreSituation(classe.label)

  .recherche
    header.recherche-tete
      p.page-meta
        each niveau, i in classe.chaine
          if i > 0
            span.atc-sep ›
          if niveau.code === classe.code
            span= niveau.code
          else
            a(href=`/classe/${niveau.code}`)= niveau.code
      h1.titre-site= classe.label
      //- Un seul chiffre, et le code une seule fois. La page en portait deux —
      //- le total de la classe et le nombre de lignes affichées — dont le
      //- second n'était pas un décompte mais une troncature déguisée en
      //- information. Et le code figurait ici en plus du fil, qui se termine
      //- déjà par lui : sur « J », la page affichait « J » deux fois de suite.
      //- Une unité, et une seule, sur toute la page : la spécialité
      //- commercialisée — un dosage, une forme, un code CIS. Les pourcentages
      //- du portrait portent sur elle aussi.
      p.page-meta
        +specialites(classe.specialites)

      //- La physionomie de la classe, en chiffres que la base connaît déjà.
      if portrait.length
        dl.portrait
          each p in portrait
            .portrait-item
              //- dt avant dd, comme le veut une liste de définitions ;
              //- l'affichage met le chiffre au-dessus (column-reverse).
              dt.portrait-libelle= p.libelle
              dd.portrait-valeur= p.valeur
        p.portrait-base Source : BDPM

    //- Le chapeau : quelques phrases de pharmacien, signées et relues. Il
    //- n'existe que là où il apporte quelque chose — une classe sans chapeau
    //- n'est pas une classe inachevée.
    if chapeau
      section.chapeau
        if !chapeau.meta.relu
          p.brouillon
            strong Brouillon
            |  — non relu, non publié.
        each bloc in chapeau.blocs
          if bloc.type === 'html'
            .chapeau-texte!= bloc.html
        p.chapeau-signature
          if chapeau.meta.auteur
            = chapeau.meta.auteur
          if chapeau.meta.relu
            |  · relu le #{new Date(chapeau.meta.relu).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}

    if classe.enfants.length > 0
      nav.classes(aria-label="Sous-classes")
        //- L'unité se dit une fois, en tête de colonne, et non à chaque ligne :
        //- « 21 spécialités commercialisées » répété quatorze fois noyait le
        //- chiffre, qui est ce qu'on compare d'une ligne à l'autre.
        h2.classes-titre
          | Sous-classes
          span.classes-unite Spécialités commercialisées
        ul.classes-liste
          each enfant in classe.enfants
            li
              a.classe-lien(href=`/classe/${enfant.code}`)
                span.classe-code= enfant.code
                span.classe-label= enfant.label
                span.classe-compte= enfant.specialites.toLocaleString('fr-FR')

    //- Ce que la classe contient, et non comment elle se découpe.
    //-
    //- Les sous-classes disent le second ; « Antiviraux à action directe »
    //- n'apprend rien à qui cherche quels antiviraux existent. Cette liste
    //- aplatit l'arbre — toutes les feuilles de la classe, la plus répandue
    //- d'abord. Vingt suffisent à donner la physionomie d'une classe ; le reste
    //- est là, replié, parce qu'une liste écourtée en silence se lit comme une
    //- liste complète.
    if molecules && molecules.length > 0
      - var TETE = 20
      - var principales = molecules.slice(0, TETE)
      - var reste = molecules.slice(TETE)
      nav.classes.classes-molecules(aria-label="Molécules de la classe")
        h2.classes-titre
          | Molécules · #{molecules.length.toLocaleString('fr-FR')}
          span.classes-unite Spécialités commercialisées
        ul.classes-liste
          each molecule in principales
            li
              a.classe-lien(href=`/classe/${molecule.code}`)
                span.classe-code= molecule.code
                span.classe-label= molecule.label
                span.classe-compte= molecule.specialites.toLocaleString('fr-FR')
        if reste.length > 0
          details.molecules-reste
            summary.molecules-plus #{reste.length.toLocaleString('fr-FR')} autre#{reste.length > 1 ? 's' : ''} molécule#{reste.length > 1 ? 's' : ''}
            ul.classes-liste
              each molecule in reste
                li
                  a.classe-lien(href=`/classe/${molecule.code}`)
                    span.classe-code= molecule.code
                    span.classe-label= molecule.label
                    span.classe-compte= molecule.specialites.toLocaleString('fr-FR')

    //- À la feuille, les spécialités elles-mêmes : une ligne par code CIS.
    //- Elles étaient regroupées par nom commercial, « 3 dosages et formes »
    //- cachant le 5 mg et le 10 mg derrière un clic ; c'est pourtant la
    //- spécialité qu'on cherche ici.
    if feuille
      - var nombre = function (g) { return g.reduce(function (t, f) { return t + f.total }, 0) }
      section.groupe
        h2.groupe-titre
          | Spécialités commercialisées
          span.compte #{nombre(commercialisees).toLocaleString('fr-FR')}
        +formes(commercialisees)
        //- Les retirées restent consultables — on cherche aussi ce qu'un patient
        //- prenait — mais repliées : elles ne sont pas la réponse au comptoir.
        if retirees.length > 0
          - var nRetirees = nombre(retirees)
          details.molecules-reste
            summary.molecules-plus #{nRetirees.toLocaleString('fr-FR')} spécialité#{nRetirees > 1 ? 's' : ''} non commercialisée#{nRetirees > 1 ? 's' : ''}
            +formes(retirees)

block scripts
  script(src=`/js/search.js?v=${v}` defer)
