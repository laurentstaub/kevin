extends layout.pug
include _barre.pug
include _recherche.pug

//- Interactions entre les médicaments d'une saisie : pour chaque paire, ce que
//- la rubrique 4.5 de chaque RCP dit de l'autre, cité tel quel. Deux colonnes,
//- parce que les deux RCP divergent souvent et que l'écart est une information.

mixin sens(s)
  //- Trois rangées partagées par les deux colonnes (titre, décompte, passages) :
  //- un décompte sur deux lignes ne décale pas les citations d'en face.
  .sens
    h3.sens-titre
      | RCP de #{s.de}
      span.sens-sur  sur #{s.sur}
    p.sens-compte
      if s.sansObjet
        | Même substance : rien à chercher dans ce sens.
      else if s.rcp === 0
        | Aucun RCP découpé en rubriques.
      else
        | #{s.citant} RCP sur #{s.rcp} nomment #{s.cherche}#{s.classes && s.classes.length ? ` ou sa classe (${s.classes.join(', ')})` : ''} en rubrique 4.5.
    .sens-corps
      //- Sens vide : le dire à la place des citations, et donner la 4.5 à lire.
      //- Un silence n'est pas une absence d'interaction.
      if !s.sansObjet && s.rcp > 0 && s.passages.length === 0
        .sens-vide
          p Aucun passage de la 4.5 ne nomme #{s.cherche}#{s.classes && s.classes.length ? ' ni sa classe' : ''}.
          if s.classes && s.classes.length
            p.manque Le RCP peut employer une formulation de classe que la table ne connaît pas encore.
          else
            p.manque Le RCP peut viser sa classe thérapeutique sans nommer la molécule : celle-ci n'est pas dans la table des classes.
          if s.lecture
            a(href=`/product/${s.lecture.cis}#${s.lecture.ancre}`) Lire la 4.5 de #{specialite(s.lecture.denomination)}
      each passage in s.passages
        blockquote.citation
          if passage.libelleNiveau
            span.niveau(class=`niveau-${passage.niveau}`)= passage.libelleNiveau
          else
            span.niveau.niveau-aucun Niveau non précisé
          //- Trouvé par le nom de la substance, ou seulement par sa classe : moins sûr.
          if passage.par === 'classe'
            span.par.par-classe Par la classe : #{passage.classe}
          else
            span.par Par la substance
          p= passage.extrait
          footer
            a(href=`/product/${passage.exemple.cis}#${passage.exemple.ancre}`)= specialite(passage.exemple.denomination)
            if passage.nb > 1
              |  et #{passage.nb - 1} autre#{passage.nb > 2 ? 's' : ''} RCP
            if passage.variantes > 0
              span.variantes  · #{passage.variantes} rédaction#{passage.variantes > 1 ? 's' : ''} voisine#{passage.variantes > 1 ? 's' : ''}
      if s.autres > 0
        p.manque #{s.autres} autre#{s.autres > 1 ? 's' : ''} rédaction#{s.autres > 1 ? 's' : ''} du même passage ou d'autres passages, dans les RCP liés.

block styles
  link(rel="stylesheet", href=`/css/fiche.css?v=${v}`)
  link(rel="stylesheet", href=`/css/interactions.css?v=${v}`)

block content
  +barreSituation('Interactions', saisie)

  main.corps
    header.fiche-entete
      h1.fiche-titre Interactions
      p.fiche-meta
        span Rubrique 4.5 des RCP, citée telle quelle
        span Recherche par substance, puis par classe

    ul.medicaments
      each m in resultat.medicaments
        li
          span.medicament-nom= m.libelle
          if m.type !== 'substance' && m.substances.length
            span.medicament-dci= m.substances.map(dci).join(' + ')
          if m.classes && m.classes.length
            span.medicament-classes Classe#{m.classes.length > 1 ? 's' : ''} : #{m.classes.map((classe) => classe.nom).join(', ')}
      each inconnu in resultat.inconnus
        li.inconnu Non reconnu : #{inconnu}

    if resultat.paires.length === 0
      p.manque Il faut au moins deux médicaments reconnus.

    each paire in resultat.paires
      section.paire
        h2.paire-titre
          | #{paire.a.libelle} × #{paire.b.libelle}
          if paire.libelleNiveau
            span.niveau(class=`niveau-${paire.niveau}`)= paire.libelleNiveau
            if paire.minorite
              //- Pas « RCP de acide… » : le nom entre parenthèses évite l'élision.
              span.niveau-part selon #{paire.minorite.nb} RCP sur #{paire.minorite.sur} (#{paire.minorite.de})
          else if !paire.cite && !paire.communes.length && !paire.memeClasse.length
            span.niveau.niveau-aucun Aucune mention trouvée
        if paire.communes.length
          p.communes Même substance dans les deux : #{paire.communes.join(', ')}.
        //- Même classe ATC de niveau 4 : un fait de classification, pas une
        //- citation ; le RCP dit ensuite s'il y a interaction.
        if paire.memeClasse.length
          p.communes
            | Même classe thérapeutique :
            each classe, i in paire.memeClasse
              |  
              a(href=`/classe/${classe.code}`) #{classe.libelle} (#{classe.code})
              if i < paire.memeClasse.length - 1
                | ,
            | .
        .paire-sens
          each s in paire.sens
            +sens(s)

    p.fiche-source
      | Chaque médicament est cherché par le nom de sa substance, puis par sa
      | classe telle que les RCP la nomment (« AINS », « anticoagulants oraux »).
      | Les classes viennent d'une table rattachée aux codes ATC, en cours de
      | relecture ; une classe qui n'y figure pas n'est pas cherchée. Une absence
      | de mention n'est donc pas une absence d'interaction. Le RCP fait foi.

block scripts
  script(src=`/js/search.js?v=${v}` defer)
