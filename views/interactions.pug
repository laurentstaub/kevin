extends layout.pug
include _barre.pug
include _recherche.pug
include _correction.pug

//- Interactions entre les médicaments d'une saisie : pour chaque paire, ce que
//- la rubrique 4.5 de chaque RCP dit de l'autre, cité tel quel. Deux colonnes,
//- parce que les deux RCP divergent souvent et que l'écart est une information.

mixin sens(s)
  //- Un sens où le RCP parle : ses citations. Les sens muets tiennent en une
  //- ligne sous la paire (mixin silence) : un « 0 RCP sur 36 » en colonne se
  //- lisait comme « pas d'interaction », même quand le thésaurus en cite une.
  //- Trois rangées partagées par les deux colonnes (titre, décompte, passages) :
  //- un décompte sur deux lignes ne décale pas les citations d'en face.
  .sens
    h3.sens-titre
      | RCP de #{s.de}
      span.sens-sur  sur #{s.sur}
    p.sens-compte Cité par #{s.citant} RCP sur #{s.rcp}
    .sens-corps
      each passage in s.passages
        blockquote.citation
          if passage.libelleNiveau
            span.niveau(class=`niveau-${passage.niveau}`)= passage.libelleNiveau
          else
            span.niveau.niveau-aucun Niveau non précisé
          //- Trouvé par le nom de la substance, ou seulement par sa classe : moins sûr.
          if passage.par === 'classe'
            span.par.par-classe Par la classe : #{passage.classe}
          else
            span.par Par la substance
          p= passage.extrait
          footer
            a(href=`/product/${passage.exemple.cis}#${passage.exemple.ancre}`)= specialite(passage.exemple.denomination)
            if passage.nb > 1
              |  et #{passage.nb - 1} autre#{passage.nb > 2 ? 's' : ''} RCP
            if passage.variantes > 0
              span.variantes  · #{passage.variantes} rédaction#{passage.variantes > 1 ? 's' : ''} voisine#{passage.variantes > 1 ? 's' : ''}
      if s.autres > 0
        p.manque #{s.autres} autre#{s.autres > 1 ? 's' : ''} rédaction#{s.autres > 1 ? 's' : ''} du même passage ou d'autres passages, dans les RCP liés.

//- Les sens où le RCP ne dit rien de l'autre médicament, sur une ligne grise :
//- ce qui a été lu, et la 4.5 à lire soi-même. Même substance : rien à dire.
mixin silence(muets)
  - const dits = muets.filter((s) => !s.sansObjet)
  if dits.length
    p.silence
      | Rubrique 4.5 :
      each s, i in dits
        |  
        if s.horsRcp
          | #{s.de} n'a pas de RCP
        else if s.rcp === 0
          | pas de RCP découpé pour #{s.de}
        else
          | rien sur #{s.sur} dans les RCP de #{s.de} (#{s.rcp} lu#{s.rcp > 1 ? 's' : ''})
          if s.lecture
            |  ·
            a(href=`/product/${s.lecture.cis}#${s.lecture.ancre}`) lire la 4.5
        | #{i < dits.length - 1 ? ' ;' : '.'}

block styles
  link(rel="stylesheet", href=`/css/fiche.css?v=${v}`)
  link(rel="stylesheet", href=`/css/interactions.css?v=${v}`)

block content
  +barreSituation('Interactions', saisie)

  main.corps
    header.fiche-entete
      h1.fiche-titre Interactions
      p.fiche-meta
        span Thésaurus de l'ANSM, puis rubrique 4.5 des RCP, cités tels quels
        span Recherche par substance, puis par classe
    +correction(corrige, saisie)

    ul.medicaments
      each m in resultat.medicaments
        li
          span.medicament-nom= m.libelle
          if m.type !== 'substance' && m.substances.length
            span.medicament-dci= m.substances.map(dci).join(' + ')
          if m.classes && m.classes.length
            span.medicament-classes Classe#{m.classes.length > 1 ? 's' : ''} : #{m.classes.map((classe) => classe.nom).join(', ')}
          if m.type === 'hors-rcp'
            span.medicament-classes Pas un médicament : thésaurus de l'ANSM seulement
      each inconnu in resultat.inconnus
        li.inconnu Non reconnu : #{inconnu}

    if resultat.paires.length === 0
      p.manque Il faut au moins deux médicaments reconnus.

    each paire in resultat.paires
      section.paire
        h2.paire-titre
          | #{paire.a.libelle} × #{paire.b.libelle}
          if paire.libelleNiveau
            span.niveau(class=`niveau-${paire.niveau}`)= paire.libelleNiveau
            if paire.niveauSource === 'ansm'
              span.niveau-part selon le thésaurus de l'ANSM
            if paire.minorite
              //- Pas « RCP de acide… » : le nom entre parenthèses évite l'élision.
              span.niveau-part selon #{paire.minorite.nb} RCP sur #{paire.minorite.sur} (#{paire.minorite.de})
          else if !paire.ansm.length && !paire.cite && !paire.communes.length && !paire.memeClasse.length
            span.niveau.niveau-aucun Aucune mention trouvée
            span.niveau-part ce n'est pas une preuve d'absence : le RCP fait foi
        if paire.communes.length
          p.communes Même substance dans les deux : #{paire.communes.join(', ')}.
        //- Même classe ATC de niveau 4 : un fait de classification, pas une
        //- citation ; le RCP dit ensuite s'il y a interaction.
        if paire.memeClasse.length
          p.communes
            | Même classe thérapeutique :
            each classe, i in paire.memeClasse
              |  
              a(href=`/classe/${classe.code}`) #{classe.libelle} (#{classe.code})
              if i < paire.memeClasse.length - 1
                | ,
            | .
        //- Le thésaurus de l'ANSM, tel qu'il écrit le couple : niveau, mécanisme,
        //- conduite à tenir. Son silence se dit aussi : l'ANSM n'a pas classé ce couple.
        .ansm
          if paire.ansm.length
            each couple in paire.ansm
              blockquote.citation.citation-ansm
                span.niveau(class=`niveau-${couple.niveaux[0]}`)= couple.libelleNiveau
                span.par #{phrase(couple.de)} + #{phrase(couple.avec)}
                p= couple.mecanisme
                if couple.conduite
                  p.conduite= couple.conduite
                footer Thésaurus des interactions médicamenteuses, ANSM, 15 septembre 2023
          else
            p.manque Thésaurus de l'ANSM (septembre 2023) : aucune entrée pour ce couple.
        - const parlants = paire.sens.filter((s) => s.passages && s.passages.length > 0)
        if parlants.length
          .paire-sens(class=parlants.length === 1 ? 'paire-sens-un' : null)
            each s in parlants
              +sens(s)
        +silence(paire.sens.filter((s) => !s.passages || s.passages.length === 0))

    p.fiche-source
      | Le thésaurus des interactions de l'ANSM est cité tel quel, dans sa
      | version finale du 15 septembre 2023 : l'ANSM ne le met plus à jour et
      | renvoie aux RCP. Dans les RCP, chaque médicament est cherché par le nom
      | de sa substance, puis par sa classe telle que les RCP la nomment
      | (« AINS », « anticoagulants oraux ») ; les classes sont les groupes du
      | thésaurus, repris tels quels. Une absence de mention n'est donc pas une
      | absence d'interaction. Le RCP fait foi.

block scripts
  script(src=`/js/search.js?v=${v}` defer)
