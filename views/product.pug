extends layout.pug
include _recherche.pug

block styles
  link(rel="stylesheet", href=`/css/product.css?v=${v}`)

block content
  mixin choixForme(v)
    if v.courante
      span.forme-choix.actif(aria-current="true")= v.variante
    else
      a.forme-choix(
        href=`/product/${v.id}`
        class=(v.commercialise === false ? 'forme-retiree' : '')
        title=(v.commercialise === false ? 'Non commercialisé' : null)
      )= v.variante

  mixin rubrique(r, ouverte)
    if r.charniere
      h4.charniere(id=r.id)
        span.num= r.numero
        span(class=r.canonical || r.libelle !== r.libelle.toUpperCase() ? 'lab' : 'lab lab-brut')= r.libelle
    else
      details.rubrique(id=r.id open=ouverte class=`rub-n${r.profondeur}` class=(r.essentielle ? 'essentielle' : null))
        summary.rubrique-tete
          span.num= r.numero
          span(class=r.canonical || r.libelle !== r.libelle.toUpperCase() ? 'lab' : 'lab lab-brut')= r.libelle
        .rubrique-corps!= r.html

  //- Identité : dénomination + toutes les métadonnées en une seule ligne,
  //- jamais répétées plus bas. Le bandeau déborde de la colonne de contenu.
  header.identite
    .identite-inner
      //- Ligne de situation : d'où l'on vient, et où l'on est dans la
      //- classification. Deux repères de navigation, tenus à l'écart de
      //- l'identité du produit — qui commence au titre.
      .identite-tete
        a.retour(href="/") ← Accueil
        span.tete-sep |
        //- Chercher depuis la fiche : au comptoir on enchaîne les médicaments,
        //- et repasser par l'accueil pour chacun coûtait deux pages.
        +champRecherche('', true)
        if resumeAtc
          span.tete-sep |
          nav.atc(aria-label="Classe thérapeutique")
            span.atc-etiquette Classe
            each niveau in resumeAtc.contexte
              span.atc-sep ›
              a.atc-maillon(href=`/classe/${niveau.code}` title=`${niveau.code} — ${niveau.label}`)= niveau.label
            span.atc-sep ›
            //- Le code porte la feuille sans l'écrire : « PARACETAMOL » répéterait
            //- la DCI affichée plus bas. Il mène au détail complet.
            a.atc-code(href=`/classe/${resumeAtc.feuille.code}` title=`${resumeAtc.feuille.code} — ${resumeAtc.feuille.label}`)= resumeAtc.feuille.code

      h1.produit-titre= product.denomination_medicament
      p.page-meta
        if product.active_ingredients
          span.dci= product.active_ingredients
          span.sep
        if product.forme_pharmaceutique
          span= product.forme_pharmaceutique
          span.sep
        if product.titulaires
          span= product.titulaires
          span.sep
        span CIS #{product.id}
        //- La procédure d'AMM change la lecture de la fiche : ce produit est le
        //- même médicament, importé et redistribué, sans documentation propre.
        if importation
          span.sep
          span.marque Importation parallèle

      //- Choisir son dosage et sa forme.
      //-
      //- La recherche rend un produit par ligne — DOLIPRANE, pas ses dix-sept
      //- codes CIS. Le choix du dosage se fait donc ici, sur la fiche, sinon il
      //- ne se fait nulle part : on arrive sur la présentation que le
      //- regroupement a désignée, et rien ne dit que c'est celle qu'on cherche.
      //- Dosages, formes et conditionnements : un seul rang. Trois lignes
      //- empilées pour deux dosages et deux boîtes, c'était trois lignes de
      //- trop. Le repli ne sert qu'aux produits qui débordent vraiment — un
      //- Doliprane a dix-sept présentations, un Seresta en a deux.
      - var SEUIL_REPLI = 8
      - var forme = product.forme_pharmaceutique
      - var soeurs = variantes || []
      - var memeForme = soeurs.filter(function (v) { return v.forme_pharmaceutique === forme })
      - var autresFormes = soeurs.filter(function (v) { return v.forme_pharmaceutique !== forme })
      - var replier = soeurs.length > SEUIL_REPLI && memeForme.length > 0 && autresFormes.length > 0
      - var enTete = replier ? memeForme : soeurs
      - var conditionnements = (product.cip_products || []).length

      if soeurs.length > 1 || conditionnements > 0
        nav.formes(aria-label="Dosages, formes et conditionnements")
          ul.formes-liste
            if soeurs.length > 1
              each v in enTete
                li
                  +choixForme(v)

              if replier
                li
                  details.formes-autres
                    summary.formes-plus #{autresFormes.length} autre#{autresFormes.length > 1 ? 's' : ''} forme#{autresFormes.length > 1 ? 's' : ''}
                    ul.formes-liste
                      each v in autresFormes
                        li
                          +choixForme(v)

            //- Les présentations sont les codes CIP rattachés au CIS affiché :
            //- elles décrivent la boîte, pas le médicament. Leur place est donc
            //- auprès du sélecteur de dosages, sur le même rang.
            if conditionnements > 0
              li
                details.presentations#presentations
                  summary.presentations-tete
                    | #{conditionnements} conditionnement#{conditionnements > 1 ? 's' : ''}
                  table.t-presentations
                    thead
                      tr
                        th(scope="col") CIP 13
                        th(scope="col") Conditionnement
                    tbody
                      each cip in product.cip_products
                        tr
                          td.code= cip.code_cip13 || cip.code_cip7
                          td= cip.libelle_presentation

  .corps
    nav.rail(aria-label="Sommaire de la fiche")
      ul.rail-plan
        each section in sections
          li
            a.rail-lien(href=`#${section.id}`)= section.label
            //- Le document ouvert affiche son plan complet : le rail ne le
            //- répète pas, il donne l'accès direct à ce qu'on ouvre au comptoir.
            if section.children
              each doc in section.children
                p.rail-doc-titre= doc.titre
                ol.rail-rubriques
                  each entry in doc.sections
                    li(class=`rub-n${entry.depth}`)
                      a.rail-lien(href=`#${entry.id}`)
                        span.num= entry.number
                        span(class=entry.canonical || entry.label !== entry.label.toUpperCase() ? 'lab' : 'lab lab-brut')= entry.label

      .rail-ailleurs
        h2.rail-titre Ce produit ailleurs
        ul
          each link in links.official
            li
              a(href=link.url target="_blank" rel="noopener noreferrer")= link.label

    main.contenu

      //- Délivrance.
      //-
      //- Le RCP répond à « que fait ce médicament ». Au comptoir, la question
      //- qui vient d'abord est l'autre : « puis-je le délivrer, et à quelles
      //- conditions ». Elle se règle en une ligne, lisible bloc fermé — liste,
      //- support d'ordonnance, durée maximale, fractionnement. Tout vient de
      //- `cis_cpd_bdpm`, donnée publique. Meddispar, édité par l'Ordre, rédige
      //- la conduite à tenir : il n'est pas ouvert, on y renvoie sans le copier.
      - var nbConditions = delivrance.groupes.reduce(function (n, g) { return n + g.conditions.length }, 0)
      details.bloc#delivrance
        summary.bloc-tete
          h2.section-titre Délivrance
          if delivrance.resume.length > 0
            //- Mentions plutôt que phrase : « Stupéfiant · Ordo sécurisée ·
            //- 4 sem. max » se saisit d'un regard, la phrase entière prenait
            //- deux lignes dans l'en-tête. Le libellé exact de la BDPM reste
            //- en infobulle et, mot pour mot, dans le corps du bloc.
            span.mentions
              each m in delivrance.resume
                span.mention(
                  class=(m.cle === 'classement' ? 'mention-classement' : null)
                  title=(m.long !== m.court ? m.long : null)
                )= m.court
          else if nbConditions > 0
            span.bloc-compte #{nbConditions} condition#{nbConditions > 1 ? 's' : ''}
          else
            span.bloc-compte Aucune condition enregistrée

        if nbConditions > 0
          dl.axes
            each g in delivrance.groupes
              dt.axe-titre= g.titre
              dd.axe-valeur
                each c in g.conditions
                  p= c

          if delivrance.liens.length > 0
            p.section-meta Conduite à tenir détaillée sur Meddispar, édité par l'Ordre national des pharmaciens :
            ul.liens
              each lien in delivrance.liens
                li
                  a(href=lien.url target="_blank" rel="noopener noreferrer")= lien.label
        else
          p.vide La base publique n'enregistre aucune condition de prescription ni de délivrance pour cette spécialité : elle n'est inscrite sur aucune liste de substances vénéneuses et n'est pas à prescription restreinte.

      //- Chaque section est un bloc repliable, fermé au chargement : la fiche
      //- s'ouvre sur son plan, pas sur trois tableaux qu'il faut dépasser.
      if hasDocuments
        details.bloc#documents(open)
          summary.bloc-tete
            h2.section-titre Documents

          //- Onglets : le RCP répond au professionnel, la notice au patient.
          //- Même page, même sommaire — on change d'interlocuteur, pas de fiche.
          if documents.length > 1
            .onglets(role="tablist" aria-label="Documents officiels")
              each doc, i in documents
                button.onglet(
                  type="button"
                  role="tab"
                  id=`onglet-${doc.type}`
                  aria-controls=doc.anchor
                  aria-selected=(i === 0 ? 'true' : 'false')
                  tabindex=(i === 0 ? 0 : -1)
                )= doc.label

          each doc, i in documents
            article.document(
              id=doc.anchor
              role=(documents.length > 1 ? 'tabpanel' : null)
              aria-labelledby=(documents.length > 1 ? `onglet-${doc.type}` : null)
              hidden=(documents.length > 1 && i > 0)
            )
              //- Une seule ligne de service : la date, la provenance, le lien
              //- officiel et la commande. Empilées, elles coûtaient trois lignes.
              p.document-meta
                if documents.length === 1
                  span= doc.label
                if doc.lastUpdated
                  span Mis à jour le #{new Date(doc.lastUpdated).toLocaleDateString('fr-FR')}
                if doc.source === 'bdpm_pdf'
                  span Texte reconstruit depuis le PDF européen
                if doc.url
                  a(href=doc.url target="_blank" rel="noopener noreferrer") Version officielle
                if doc.rubriques && doc.rubriques.length > 0
                  button.deplier(type="button" data-cible=doc.anchor) Tout déplier
                if doc.manquantes && doc.manquantes.length > 0
                  span.manquantes Rubriques absentes du document source : #{doc.manquantes.join(', ')}

              if doc.emprunte
                p.emprunt
                  strong Texte emprunté.
                  |  Cette spécialité est une importation parallèle : la base publique ne lui attribue ni RCP ni notice. Le document ci-dessous est celui de&nbsp;
                  a(href=`/product/${doc.emprunte.id}`)= doc.emprunte.denomination_medicament
                  if doc.emprunte.titulaires
                    |  (#{doc.emprunte.titulaires.trim()})
                  | , dont ce produit est la copie distribuée en France.

              if doc.rubriques && doc.rubriques.length > 0
                .rubriques
                  //- Le document garde sa numérotation : 1, 2, 3, 4, 4.1… Un
                  //- RCP se cite par ses rubriques, et l'ordre officiel est
                  //- celui que le lecteur connaît. Seule l'ouverture est
                  //- dirigée — toute la rubrique 4 est dépliée, le reste attend.
                  each r in doc.rubriques
                    +rubrique(r, r.clinique === true)

              else if doc.html
                .document-corps!= doc.html

              else if doc.url
                p.doc-externe
                  | Ce document n'est disponible qu'au format PDF sur le site officiel.

      if substitutions.length > 0
        details.bloc#substituer
          summary.bloc-tete
            h2.section-titre Substituer
            span.bloc-compte #{substitutions.length} produit#{substitutions.length > 1 ? 's' : ''}
          if genericGroup
            p.section-meta Groupe générique · #{genericGroup}
          table.t-substitution
            caption.sr-only Produits substituables ou partageant le principe actif
            thead
              tr
                th(scope="col") Dénomination
                th(scope="col") Forme
                th(scope="col") Rôle
            tbody
              each item in substitutions
                tr
                  td
                    a(href=`/product/${item.id}`)= item.denomination_medicament
                    if item.active_ingredients && item.active_ingredients !== product.active_ingredients
                      .ligne-dci= item.active_ingredients
                  td.forme= item.forme_pharmaceutique || '—'
                  td
                    span.role(class=item.role === 'Princeps' ? 'role-princeps' : '')= item.role

      details.bloc#references
        summary.bloc-tete
          h2.section-titre Références
          if links.scientific.length > 0
            span.bloc-compte Littérature et registres
        if links.scientific.length > 0
          p.section-meta Sur #{links.scientific[0].hint}
          ul.liens
            each link in links.scientific
              li
                a(href=link.url target="_blank" rel="noopener noreferrer")= link.label
        else
          p.vide Aucun principe actif renseigné pour interroger la littérature.

block scripts
  script(src=`/js/search.js?v=${v}` defer)
  script(src=`/js/rail.js?v=${v}` defer)
  script(src=`/js/documents.js?v=${v}` defer)
