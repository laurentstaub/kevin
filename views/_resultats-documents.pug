//- Trouvailles en tableau : une ligne par molécule, une colonne par rubrique.
//- Colonnes fixes pour rester apprises ; le reste va dans « Autres ». Un nom de
//- groupe peut dépasser 1 600 caractères. Cliquer un en-tête filtre sur la
//- rubrique : le tableau se réduit alors à la molécule et l'extrait.
//-
//- @param {object}  recherche sortie de chercherDansDocuments
//- @param {string}  requete   la requête, pour le lien « tout voir » et les filtres
//- @param {boolean} resume    vue courte, au sein de la page de résultats
//- @param {Array}   colonnes  [[numéro, libellé], …] — COLONNES
//- @param {string}  rubrique  la rubrique filtrée, ou rien
mixin resultatsDocuments(recherche, requete, resume, colonnes, rubrique, etat, lien)
  - const cles = colonnes.map((colonne) => colonne[0])
  - const colonnesVues = rubrique ? [] : colonnes
  //- Transmise à la fiche, qui la surligne.
  - const q = `?q=${encodeURIComponent(requete)}`

  //- Légende inutile pour un mot seul ou une locution entre guillemets (tout est plein).
  if recherche.exacte && !rubrique
    p.legende
      span.point.point-legende(aria-hidden="true")
      |  « #{requete} » tel quel
      span.point.point-epars.point-legende(aria-hidden="true")
      |  les mots, dispersés

  table.trouvailles(class=rubrique ? 'trouvailles-filtrees' : null)
    caption.sr-only
      | Molécules dont un document contient l'expression cherchée, et rubriques où elle figure
    colgroup
      col.col-molecule
      each colonne in colonnesVues
        col.col-rubrique
      if !rubrique
        col.col-autres
    thead
      tr
        //- La rubrique active est annoncée dans la ligne d'état, pas ici.
        th.th-molecule(scope="col") Molécule
        each colonne in colonnesVues
          th.th-rubrique(scope="col")
            a.th-lien(href=lien(etat, { rubrique: colonne[0] })
              data-titre=`N'afficher que ${colonne[0]} ${colonne[1]}`)= colonne[0]
        if !rubrique
          th.th-autres(scope="col") Autres

    each trouvaille in recherche.resultats
      -
        const rubriques = trouvaille.rubriques || [];
        const par = Object.fromEntries(rubriques
          .filter((rub) => rub.type !== 'notice')
          .map((rub) => [rub.numero, rub]));
        const autres = rubriques.filter((rub) => rub.type === 'notice' || !cles.includes(rub.numero));
        // Préfixe « N » : la rubrique 2 d'une notice n'est pas celle d'un RCP.
        const court = (rub) => (rub.type === 'notice' ? 'N' : '') + rub.numero;
        const long = (rub) => (rub.type === 'notice' ? 'Notice · ' : '') + rub.numero + ' ' + rub.libelle
          + (recherche.exacte && !rub.exact ? ' — mots séparés' : '');

      tbody.trouvaille
        - const formes = trouvaille.formes || []
        tr
          th.cellule-molecule(scope="row")
            //- Plusieurs spécialités : la molécule déplie ses dosages (ligne suivante).
            //- Une seule : lien direct vers son passage, requête surlignée.
            if formes.length && trouvaille.specialites > 1
              details.trouvaille-details
                summary
                  span.trouvaille-molecule(title=trouvaille.molecule)= trouvaille.molecule
                  span.trouvaille-reprise(title=`${trouvaille.specialites} spécialités`) #{trouvaille.specialites.toLocaleString('fr-FR')} spé.
            else
              span.trouvaille-tete
                a.trouvaille-molecule(
                  href=`/product/${trouvaille.code_cis}${q}#${trouvaille.ancre}`
                  title=trouvaille.molecule
                )= trouvaille.molecule
                if trouvaille.specialites > 1
                  span.trouvaille-reprise(title=`${trouvaille.specialites} spécialités`) #{trouvaille.specialites.toLocaleString('fr-FR')} spé.

          //- Point plein : expression telle quelle ; creux : mots dispersés.
          //- La phrase paraît au survol (extraits.js) ; sans JavaScript, lien et `title`.
          each colonne in colonnesVues
            td.cellule-rubrique
              if par[colonne[0]]
                - const rub = par[colonne[0]]
                a.point(
                  class=recherche.exacte && !rub.exact ? 'point-epars' : null
                  href=`/product/${rub.cis}${q}#${rub.ancre}`
                  title=long(rub)
                  aria-label=long(rub)
                  data-cis=rub.cis
                  data-type=rub.ancre.split('-')[0]
                  data-position=rub.ancre.split('-')[1]
                )

          if !rubrique
            td.cellule-autres
              each rub in autres
                a.autre(
                  class=recherche.exacte && !rub.exact ? 'point-epars' : null
                  href=`/product/${rub.cis}${q}#${rub.ancre}`
                  title=long(rub)
                  aria-label=long(rub)
                  data-cis=rub.cis
                  data-type=rub.ancre.split('-')[0]
                  data-position=rub.ancre.split('-')[1]
                )= court(rub)

        //- Dépliée par la molécule ; masquée par CSS tant qu'elle est repliée.
        if formes.length && trouvaille.specialites > 1
          tr.ligne-dosages
            td(colspan=1 + colonnesVues.length + (rubrique ? 0 : 1))
              each groupeForme in formes
                p.dosages-forme= groupeForme.forme
                each groupeNom in groupeForme.noms
                  .resultat-forme
                    span.dosages-nom= groupeNom.nom
                    if groupeNom.princeps
                      span.marque Princeps
                    if groupeNom.importation
                      span.marque Importation
                    +dosages(groupeNom, requete)

        //- Filtré sur une rubrique, la phrase s'affiche d'office.
        if rubrique && trouvaille.extrait
          tr.ligne-phrase
            td
              //- Non échappé : ts_headline n'ajoute que <mark> au texte échappé.
              p.trouvaille-extrait!= trouvaille.extrait
              p.preuve-source
                a(href=`/product/${trouvaille.code_cis}${q}#${trouvaille.ancre}`)= trouvaille.denomination

  if resume && recherche.total > recherche.resultats.length
    p.trouvailles-suite
      a(href=lien(etat, { mode: 'documents' }))
        | Voir les #{recherche.borne ? 'plus de ' : ''}#{recherche.total.toLocaleString('fr-FR')} rubriques et filtrer →
  else if recherche.borne
    //- Un décompte plafonné doit se dire plafonné.
    p.section-meta
      | Recherche arrêtée aux #{recherche.total.toLocaleString('fr-FR')} premières rubriques trouvées.
      |  Affinez la requête ou choisissez une rubrique pour un décompte exact.
