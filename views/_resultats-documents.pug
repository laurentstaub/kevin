//- Les trouvailles, en tableau.
//-
//- Une ligne par molécule, une colonne par rubrique. C'est de la donnée
//- tabulaire, et l'écrire comme telle règle d'un coup ce qu'une grille CSS
//- tenait par la chance : les numéros posés au fil de la ligne ne se
//- comparaient pas d'une ligne à l'autre, puis, alignés en grille, ils se
//- décalaient dès qu'un nom de groupe était long — `space-between` cesse
//- d'aligner à droite quand le contenu déborde, et un nom de groupe n'a pas
//- de longueur bornée : médiane 28 caractères, mais 442 au 99ᵉ centile et
//- 1 668 au pire, les vaccins pneumococciques nommant chacun de leurs
//- sérotypes.
//-
//- Les colonnes sont fixes, et non l'union de ce que la recherche a trouvé :
//- des colonnes qui changent de place d'une requête à l'autre ne s'apprennent
//- jamais. Ce qui tombe hors des huit va dans « Autres », qui les nomme sans
//- leur réserver de place.
//-
//- Une ligne par molécule, rien de plus. Ce qu'une rubrique dit se lit au
//- survol de son point : la ligne d'extrait qui suivait chaque molécule
//- triplait la hauteur du tableau pour une phrase qu'on ne lit qu'une fois
//- sur dix, et c'était la moins utile — celle du meilleur score, souvent un
//- 5.2 de pharmacocinétique.
//-
//- L'en-tête est le filtre.
//-
//- Une rangée d'onglets listait ces huit mêmes rubriques deux lignes plus
//- haut : la même liste écrite deux fois sur le même écran, dont l'une ne
//- portait aucune donnée. On restreint une colonne en cliquant sur la
//- colonne — et dès qu'une rubrique est choisie, les colonnes n'ont plus
//- d'objet, puisque toutes les trouvailles sont dans celle-là. Le tableau se
//- réduit alors à ce qui répond : la molécule et l'extrait.
//-
//- @param {object}  d         sortie de chercherDansDocuments
//- @param {string}  q         la requête, pour le lien « tout voir » et les filtres
//- @param {boolean} resume    vue courte, au sein de la page de résultats
//- @param {Array}   colonnes  [[numéro, libellé], …] — COLONNES
//- @param {string}  rubrique  la rubrique filtrée, ou rien
mixin resultatsDocuments(d, q, resume, colonnes, rubrique, etat, lien)
  - var cles = colonnes.map(function (c) { return c[0] })
  - var colonnesVues = rubrique ? [] : colonnes

  //- La légende ne paraît que s'il y a quelque chose à distinguer : pour un
  //- mot seul, ou une locution entre guillemets, tous les points sont pleins.
  if d.exacte && !rubrique
    p.legende
      span.point.point-legende(aria-hidden="true")
      |  « #{q} » tel quel
      span.point.point-epars.point-legende(aria-hidden="true")
      |  les mots, dispersés

  table.trouvailles(class=rubrique ? 'trouvailles-filtrees' : null)
    caption.sr-only
      | Molécules dont un document contient l'expression cherchée, et rubriques où elle figure
    colgroup
      col.col-molecule
      each c in colonnesVues
        col.col-rubrique
      if !rubrique
        col.col-autres
    thead
      tr
        //- La rubrique active se disait ici ; elle est passée dans la ligne
        //- d'état, avec la requête et le décompte, pour que l'état de la
        //- recherche se lise d'un seul endroit.
        th.th-molecule(scope="col") Molécule
        each c in colonnesVues
          th.th-rubrique(scope="col")
            a.th-lien(href=lien(etat, { rubrique: c[0] })
              data-titre=`N'afficher que ${c[0]} ${c[1]}`)= c[0]
        if !rubrique
          th.th-autres(scope="col") Autres

    each r in d.resultats
      -
        var par = {};
        (r.rubriques || []).forEach(function (rub) {
          if (rub.type !== 'notice') par[rub.numero] = rub;
        });
        var autres = (r.rubriques || []).filter(function (rub) {
          return rub.type === 'notice' || cles.indexOf(rub.numero) === -1;
        });
        // Les notices se nomment « N2 » : la rubrique 2 d'une notice (avant de
        // prendre) n'est pas la rubrique 2 d'un RCP (la composition).
        var court = function (rub) { return (rub.type === 'notice' ? 'N' : '') + rub.numero };
        var long = function (rub) {
          return (rub.type === 'notice' ? 'Notice · ' : '') + rub.numero + ' ' + rub.libelle
            + (d.exacte && !rub.exact ? ' — mots séparés' : '');
        };

      tbody.trouvaille
        tr
          th.cellule-molecule(scope="row")
            //- Deux spécialités sur treize mille six cents n'ont pas de
            //- composition enregistrée : leur dénomination tient lieu de titre,
            //- et mène à leur fiche plutôt qu'à une recherche par principe
            //- actif qui ne rendrait rien.
            if r.sansMolecule
              a.trouvaille-molecule(href=`/product/${r.code_cis}#${r.ancre}`)= r.molecule
            else
              a.trouvaille-molecule(
                href=lien(etat, { mode: 'nom', requete: r.molecule, filtre: 'active' })
                title=r.molecule
              )= r.molecule
            //- Combien de spécialités le groupe recouvre, sur la même ligne :
            //- une seconde ligne pour un nombre doublait la hauteur du tableau.
            if r.specialites > 1
              span.trouvaille-reprise(title=`${r.specialites} spécialités`) #{r.specialites.toLocaleString('fr-FR')} spé.

          //- Un point par rubrique, et non plus son numéro : l'en-tête le dit
          //- déjà, et le répéter dans chaque case faisait un tableau de
          //- chiffres où rien ne ressortait. Plein, l'expression y figure
          //- telle quelle ; creux, les mots y sont mais dispersés.
          //- La phrase paraît au survol (extraits.js) ; sans JavaScript, le
          //- point reste un lien vers la rubrique, et `title` la nomme.
          each c in colonnesVues
            td.cellule-rubrique
              if par[c[0]]
                - var rub = par[c[0]]
                a.point(
                  class=d.exacte && !rub.exact ? 'point-epars' : null
                  href=`/product/${rub.cis}#${rub.ancre}`
                  title=long(rub)
                  aria-label=long(rub)
                  data-cis=rub.cis
                  data-type=rub.ancre.split('-')[0]
                  data-position=rub.ancre.split('-')[1]
                )

          if !rubrique
            td.cellule-autres
              each rub in autres
                a.autre(
                  class=d.exacte && !rub.exact ? 'point-epars' : null
                  href=`/product/${rub.cis}#${rub.ancre}`
                  title=long(rub)
                  aria-label=long(rub)
                  data-cis=rub.cis
                  data-type=rub.ancre.split('-')[0]
                  data-position=rub.ancre.split('-')[1]
                )= court(rub)

        //- Filtrée sur une rubrique, la page n'a plus de colonnes : la phrase
        //- devient la réponse, et se montre sans qu'on la demande.
        if rubrique && r.extrait
          tr.ligne-phrase
            td
              //- La phrase vient de la base : ts_headline n'y ajoute que
              //- <mark> et l'échappement, le reste est le texte du document.
              p.trouvaille-extrait!= r.extrait
              p.preuve-source
                a(href=`/product/${r.code_cis}#${r.ancre}`)= r.denomination

  if resume && d.total > d.resultats.length
    p.trouvailles-suite
      a(href=lien(etat, { mode: 'documents' }))
        | Voir les #{d.borne ? 'plus de ' : ''}#{d.total.toLocaleString('fr-FR')} rubriques et filtrer →
  else if d.borne
    //- Un décompte plafonné doit se dire plafonné : annoncer « 3 000 » comme
    //- un total ferait passer une borne pour une mesure.
    p.section-meta
      | Recherche arrêtée aux #{d.total.toLocaleString('fr-FR')} premières rubriques trouvées.
      |  Affinez la requête ou choisissez une rubrique pour un décompte exact.
