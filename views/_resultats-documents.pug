//- Une trouvaille dans les documents : une molécule, pas une spécialité.
//-
//- La ligne dit trois choses dans l'ordre où on les lit : quelle molécule,
//- dans quelles rubriques, et — à la demande — la phrase qui le prouve.
//-
//- Grouper par molécule plutôt que par empreinte de texte divise la liste par
//- quatre en moyenne, et bien davantage sur ce qu'on cherche vraiment :
//- olanzapine 66 spécialités, aripiprazole 63, rispéridone 62. Chaque numéro
//- de rubrique porte sa propre ancre, prise sur sa meilleure occurrence — un
//- numéro qui mènerait à une spécialité tirée au sort du groupe serait pire
//- qu'absent.
//-
//- @param {object}  d       sortie de chercherDansDocuments
//- @param {string}  q       la requête, pour le lien « tout voir »
//- @param {boolean} resume  vue courte, au sein de la page de résultats
mixin resultatsDocuments(d, q, resume)
  //- Les rubriques en colonnes.
  //-
  //- Les numéros posés au fil de chaque ligne ne se comparaient pas d'une
  //- ligne à l'autre : pour savoir quelles molécules en parlent en 4.5, il
  //- fallait lire chaque ligne entière. Rangés en grille, la colonne répond
  //- d'un coup d'œil, et un trou se voit autant qu'une case pleine.
  //-
  //- La grille est celle de la page, pas de la ligne : l'ensemble des
  //- rubriques trouvées, dans l'ordre du document. Au-delà de douze colonnes
  //- elle deviendrait plus étroite que lisible — on repasse alors au fil.
  -
    var rang = function (n) {
      var m = String(n).match(/^(\d+)(?:\.(\d+))?/);
      return [m ? +m[1] : 99, m && m[2] !== undefined ? +m[2] : -1];
    };
    var numeros = [];
    (d.resultats || []).forEach(function (r) {
      (r.rubriques || []).forEach(function (rub) {
        if (numeros.indexOf(rub.numero) === -1) numeros.push(rub.numero);
      });
    });
    numeros.sort(function (a, b) {
      var x = rang(a), y = rang(b);
      return x[0] - y[0] || x[1] - y[1] || (a < b ? -1 : 1);
    });
    var grille = numeros.length > 1 && numeros.length <= 12;

  ul.trouvailles
    each r in d.resultats
      li.trouvaille
        .trouvaille-tete
          //- Deux spécialités sur treize mille six cents n'ont pas de
          //- composition enregistrée : leur dénomination tient lieu de titre,
          //- et mène à leur fiche plutôt qu'à une recherche par principe actif
          //- qui ne rendrait rien.
          if r.sansMolecule
            a.trouvaille-molecule(href=`/product/${r.code_cis}#${r.ancre}`)= r.molecule
          else
            a.trouvaille-molecule(
              href=`/search?q=${encodeURIComponent(r.molecule)}&filter=active`
              title="Toutes les spécialités contenant cette molécule"
            )= r.molecule

          if r.rubriques && r.rubriques.length > 0
            - var par = {}; r.rubriques.forEach(function (rub) { par[rub.numero] = rub });
            ul.puces(class=grille ? 'puces-grille' : null style=grille ? `--colonnes: ${numeros.length}` : null)
              each numero in (grille ? numeros : r.rubriques.map(function (x) { return x.numero }))
                li
                  if par[numero]
                    //- L'infobulle est la nôtre, pas celle du navigateur :
                    //- `title` attend une seconde avant de paraître, et sur
                    //- une ligne de chiffres c'est une seconde par chiffre.
                    a.puce(
                      href=`/product/${par[numero].cis}#${par[numero].ancre}`
                      data-titre=`${numero} ${par[numero].libelle}`
                      aria-label=`${numero} ${par[numero].libelle}`
                    )= numero

        //- Combien de spécialités le groupe recouvre. Une seule ne se dit pas :
        //- ce serait une ligne pour ne rien apprendre.
        if r.specialites > 1
          p.trouvaille-reprise #{r.specialites.toLocaleString('fr-FR')} spécialités

        //- L'extrait est la preuve, et il est replié.
        //-
        //- « OLANZAPINE · 4.4 » ne dit pas si le RCP énonce que le produit
        //- allonge le QT ou qu'il est contre-indiqué en cas d'allongement : au
        //- comptoir, c'est toute la réponse. Mais une molécule n'a pas un seul
        //- RCP — tramadol LP et tramadol à libération immédiate ont des textes
        //- différents — d'où la spécialité nommée sous l'extrait : on ne prête
        //- pas à la molécule une phrase qui n'est vraie que d'une forme.
        details.preuve
          summary.preuve-tete Extrait
          //- `ts_headline` de Postgres, dont seuls <mark> et l'échappement
          //- viennent de la base : le texte est celui du document.
          p.trouvaille-extrait!= r.extrait
          p.preuve-source
            a(href=`/product/${r.code_cis}#${r.ancre}`)= r.denomination
            if r.numero
              |  · #{r.numero} #{r.libelle}
            else if r.libelle
              |  · #{r.libelle}

  if resume && d.total > d.resultats.length
    p.trouvailles-suite
      a(href=`/documents?q=${encodeURIComponent(q)}`)
        | Voir les #{d.borne ? 'plus de ' : ''}#{d.total.toLocaleString('fr-FR')} rubriques et filtrer →
  else if d.borne
    //- Un décompte plafonné doit se dire plafonné : annoncer « 3 000 » comme
    //- un total ferait passer une borne pour une mesure.
    p.section-meta
      | Recherche arrêtée aux #{d.total.toLocaleString('fr-FR')} premières rubriques trouvées.
      |  Affinez la requête ou choisissez une rubrique pour un décompte exact.
