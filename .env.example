# Copier en .env — ce fichier ne doit jamais être commité.

NODE_ENV=development
PORT=3000

# Base PostgreSQL. Soit une URL complète…
# DATABASE_URL=postgres://user:motdepasse@localhost:5432/bdpm
# …soit les variables séparées :
PGUSER=laurentstaub4
PGHOST=localhost
PGDATABASE=incidents_json
PGPORT=5432
# PGPASSWORD=

PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=5000

# Bornes de recherche
SEARCH_MIN_LENGTH=3
# Par famille de résultats (dénomination / principe actif), pas au total.
SEARCH_LIMIT=60
SUGGEST_LIMIT=8
RELATED_LIMIT=40

# Origines autorisées pour le CORS (vide = même origine uniquement)
# CORS_ORIGINS=https://app.antheosdata.com

# Base contre laquelle se résolvent les file_path relatifs de la BDPM
# (« /documents/<CIS>/rcp_notice.pdf »)
DOCUMENT_BASE_URL=https://base-donnees-publique.medicaments.gouv.fr

# Domaines autorisés pour les redirections vers les documents officiels
DOCUMENT_HOSTS=ansm.sante.fr,base-donnees-publique.medicaments.gouv.fr,bdpmt.ansm.sante.fr,ema.europa.eu

# Liens sortants — {cis} = code CIS, {q} = terme encodé
LINK_BDPM=https://base-donnees-publique.medicaments.gouv.fr/extrait.php?specid={cis}
LINK_PUBMED=https://pubmed.ncbi.nlm.nih.gov/?term={q}
LINK_TRIALS=https://clinicaltrials.gov/search?intr={q}
LINK_EMA=https://www.ema.europa.eu/en/search?search_api_fulltext={q}

# Pont vers le projet ruptures d'approvisionnement
LINK_AVAILABILITY=https://app.antheosdata.com/?q={q}
